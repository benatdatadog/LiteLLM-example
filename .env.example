# AWS Bedrock (used by LiteLLM proxy and direct SDK calls)
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary/SSO credentials
# AWS_SESSION_TOKEN=
# Optional if using ~/.aws/credentials profiles instead of keys above
# AWS_PROFILE=default

# Datadog LLM Observability (required when using ddtrace-run)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=litellm-demo
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_ENV=dev
DD_SERVICE=litellm-demo

# Demo app settings
# Proxy alias from proxy/config.yaml (when using LITELLM_PROXY_URL)
DEMO_MODEL=bedrock-claude-haiku
# Or direct Bedrock model id when calling LiteLLM SDK without the proxy:
# DEMO_MODEL=bedrock/anthropic.claude-haiku-4-5-20251001-v1:0
# Use inference profile id (required for on-demand Bedrock):
# DEMO_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
DEMO_TEAM=platform-engineering
DEMO_USER_HANDLE=demo@example.com

# Set to true to skip real LLM API calls (still sends Datadog traces)
# DEMO_MOCK=true

# LiteLLM Proxy + Datadog Agent integration (metrics/logs dashboard)
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-demo
